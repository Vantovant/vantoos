generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks          Task[]
  reminders      Reminder[]
  meetings       Meeting[]
  notes          Note[]
  contacts       Contact[]
  notifications  Notification[]
  preferences    UserPreference?
  executiveCtx   ExecutiveContext?
  snapshots      ExecutiveSnapshot[]
}

model Task {
  id            String   @id @default(cuid())
  title         String
  description   String?
  priority      String?
  status        String?
  autoScheduled Boolean  @default(false)
  dueDate       DateTime?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  remindAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  startTime DateTime?
  endTime   DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String?
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])
}

model ExecutiveContext {
  id            String   @id @default(cuid())
  userId        String   @unique
  vision        String?
  quarterlyGoal String?
  weeklyFocus   String?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ExecutiveSnapshot {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  weeklyFocus     String?
  priorityTasks   Json
  meetingsToday   Json
  urgentReminders Json
  stats           Json

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  timezone          String   @default("Africa/Johannesburg")
  language          String   @default("en")
  theme             String   @default("system")
  workingHoursStart String?
  workingHoursEnd   String?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}